{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "euterpe/schema/players.schema.json",
  "title": "Euterpe agent: players.yaml",
  "description": "The players (human, agent, metronome), their instruments and mixer settings.",
  "type": "object",
  "required": ["players"],
  "additionalProperties": false,
  "definitions": {
    "player": {
      "type": "object",
      "required": ["label", "instruments"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string"},
        "mute": {"type": "boolean"},
        "volume": {"type": "number", "minimum": 0, "maximum": 10},
        "instruments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "enum": ["piano", "drums", "upright_bass", "click", "synth"], "description": "The sampler (or 'synth', an FM synth)."},
              "label": {"type": "string"},
              "mute": {"type": "boolean"},
              "volume": {"type": "number", "minimum": 0, "maximum": 10},
              "default": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "properties": {
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human", "agent"],
      "properties": {
        "human": {"$ref": "#/definitions/player"},
        "agent": {"$ref": "#/definitions/player"},
        "metronome": {"$ref": "#/definitions/player"}
      }
    }
  }
}
