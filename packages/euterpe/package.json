{
  "name": "euterpe",
  "version": "0.1.2",
  "description": "A browser framework for real-time interactive music agents: write the agent's hooks and YAML, Euterpe does MIDI and audio input, the clock, quantization, samplers and the UI.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./agent": {
      "types": "./types/agent.d.ts",
      "default": "./src/agent.js"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "default": "./vite/index.js"
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "vite",
    "cli",
    "types",
    "schema",
    "assets",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "music",
    "interactive",
    "agent",
    "midi",
    "web-audio",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xribene/Euterpe.git",
    "directory": "packages/euterpe"
  },
  "peerDependencies": {
    "vite": "^5.0.0",
    "playwright-core": ">=1.40"
  },
  "dependencies": {
    "@tonaljs/note": "~4.10.0",
    "@tonaljs/tonal": "~4.10.0",
    "@vitejs/plugin-vue2": "^2.3.1",
    "ajv": "^8.17.1",
    "audiokeys": "^0.1.1",
    "chart.js": "^3.9.1",
    "js-yaml": "^4.1.0",
    "markdown-it-vue": "^1.1.7",
    "remixicon": "^3.5.0",
    "ringbuf.js": "^0.3.6",
    "three": "^0.159",
    "tone": "14.7.77",
    "tweakpane": "^3.1.10",
    "vexflow": "4.2.3",
    "vue": "^2.7.15",
    "vue-chartjs": "^4.1.2",
    "vue-js-modal": "^2.0.1",
    "vue-js-toggle-button": "^1.3.3",
    "vue-material": "^1.0.0-beta-16",
    "vue-simple-search-dropdown": "^1.0.1",
    "vue-toasted": "^1.1.28",
    "vue2-touch-events": "^3.2.3",
    "vuex": "^3.6.2",
    "webmidi": "3.1.7"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.3",
    "vite": "^5.0.10"
  },
  "scripts": {
    "gen-types": "node scripts/gen-config-types.mjs"
  },
  "bin": {
    "euterpe": "cli/index.js"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  }
}
