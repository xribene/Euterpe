{
  "compilerOptions": {
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true
  },
  "include": [
    "agent/**/*.js",
    "agent/**/*.ts"
  ]
}
